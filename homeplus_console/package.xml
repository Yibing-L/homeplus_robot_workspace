<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>homeplus_console</name>
  <version>0.1.0</version>
  <description>HomePlus operator console: one browser UI over the robot (state, video, approvals, recovery).</description>
  <maintainer email="ev264@cornell.edu">Eashan Vagish</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>homeplus_interfaces</exec_depend>
  <exec_depend>homeplus_urdf_description</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
