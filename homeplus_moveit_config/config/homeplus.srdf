<?xml version="1.0" encoding="UTF-8"?>
<robot name="homeplus_urdf">
    <group name="arm">
        <chain base_link="base_link" tip_link="grasp_tcp"/>
    </group>


    <group name="base_arm">
        <chain base_link="world" tip_link="grasp_tcp"/>
    </group>
    
    <group name="gripper">
        <joint name="joint_grip_L"/>
    </group>

    <end_effector name="gripper" parent_link="palm_1" group="gripper"/>
    
    <group_state name="home" group="base_arm">
        <joint name="base_x" value="0"/>
        <joint name="base_y" value="0"/>
        <joint name="base_theta" value="0"/>
        <joint name="joint_shoulder" value="0"/>
        <joint name="joint_elbow" value="0"/>
        <joint name="joint_wrist" value="0"/>
        <joint name="joint_hand" value="0"/>
    </group_state>

    <disable_collisions link1="base_link" link2="wheel_RR_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="wheel_RL_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="wheel_FL_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="wheel_FR_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="upper_arm_1" reason="Adjacent"/>
    <disable_collisions link1="upper_arm_1" link2="forearm_1" reason="Adjacent"/>
    <disable_collisions link1="forearm_1" link2="wrist_1" reason="Adjacent"/>
    <disable_collisions link1="wrist_1" link2="palm_1" reason="Adjacent"/>
    <disable_collisions link1="palm_1" link2="FingerL_new_1" reason="Adjacent"/>
    <disable_collisions link1="palm_1" link2="FingerR_new_1" reason="Adjacent"/>
    <disable_collisions link1="FingerL_new_1" link2="FingerR_new_1" reason="Never"/>
    <disable_collisions link1="palm_1" link2="hand_camera_link_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="front_camera_link_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="rear_camera_link_1" reason="Adjacent"/>

    <!-- Cameras are sensor frames with no real collision geometry; disable
         collision checks vs every other link to prevent false positives. -->
    <disable_collisions link1="front_camera_link_1" link2="wheel_FL_1"        reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="wheel_FR_1"        reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="wheel_RL_1"        reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="wheel_RR_1"        reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="upper_arm_1"       reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="forearm_1"         reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="wrist_1"           reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="palm_1"            reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="FingerL_new_1"     reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="FingerR_new_1"     reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="hand_camera_link_1" reason="Never"/>
    <disable_collisions link1="front_camera_link_1" link2="rear_camera_link_1" reason="Never"/>

    <disable_collisions link1="rear_camera_link_1"  link2="wheel_FL_1"        reason="Never"/>
    <disable_collisions link1="rear_camera_link_1"  link2="wheel_FR_1"        reason="Never"/>
    <disable_collisions link1="rear_camera_link_1"  link2="wheel_RL_1"        reason="Never"/>
    <disable_collisions link1="rear_camera_link_1"  link2="wheel_RR_1"        reason="Never"/>
    <disable_collisions link1="rear_camera_link_1"  link2="upper_arm_1"       reason="Never"/>
    <disable_collisions link1="rear_camera_link_1"  link2="forearm_1"         reason="Never"/>
    <disable_collisions link1="rear_camera_link_1"  link2="wrist_1"           reason="Never"/>
    <disable_collisions link1="rear_camera_link_1"  link2="palm_1"            reason="Never"/>
    <disable_collisions link1="rear_camera_link_1"  link2="FingerL_new_1"     reason="Never"/>
    <disable_collisions link1="rear_camera_link_1"  link2="FingerR_new_1"     reason="Never"/>
    <disable_collisions link1="rear_camera_link_1"  link2="hand_camera_link_1" reason="Never"/>

    <disable_collisions link1="hand_camera_link_1"  link2="base_link"         reason="Never"/>
    <disable_collisions link1="hand_camera_link_1"  link2="wheel_FL_1"        reason="Never"/>
    <disable_collisions link1="hand_camera_link_1"  link2="wheel_FR_1"        reason="Never"/>
    <disable_collisions link1="hand_camera_link_1"  link2="wheel_RL_1"        reason="Never"/>
    <disable_collisions link1="hand_camera_link_1"  link2="wheel_RR_1"        reason="Never"/>
    <disable_collisions link1="hand_camera_link_1"  link2="upper_arm_1"       reason="Never"/>
    <disable_collisions link1="hand_camera_link_1"  link2="forearm_1"         reason="Never"/>
    <disable_collisions link1="hand_camera_link_1"  link2="wrist_1"           reason="Never"/>
    <disable_collisions link1="hand_camera_link_1"  link2="FingerL_new_1"     reason="Never"/>
    <disable_collisions link1="hand_camera_link_1"  link2="FingerR_new_1"     reason="Never"/>

</robot>
